%% ---------------------------------------------------------------------------
%% Code and terminal-like content - portable; no shell escape required.
%% ---------------------------------------------------------------------------
\lstdefinestyle{ma-code}{
  basicstyle=\ttfamily\small\color{MAInk},
  backgroundcolor=\color{MASurfaceAlt},
  numbers=left,
  numberstyle=\scriptsize\color{MAMuted},
  numbersep=10pt,
  frame=none,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  keepspaces=true,
  columns=fullflexible,
  tabsize=2,
  keywordstyle=\bfseries\color{MAPrimaryDark},
  commentstyle=\itshape\color{MATertiary},
  stringstyle=\color{MASecondary},
  rulecolor=\color{MARule},
  xleftmargin=2pt,
  xrightmargin=2pt,
  aboveskip=0pt,
  belowskip=0pt
}
\newtcblisting{codigo}[2][]{ma/code,title={\sffamily\bfseries\footnotesize\color{MAInk}#2},colbacktitle=MASurfaceAlt,coltitle=MAInk,
  listing only,listing options={style=ma-code,#1}}
\newtcolorbox{salidaesperada}[1][]{ma/base,colback=MASurfaceAlt,coltitle=MAMuted,borderline west={2.5pt}{0pt}{MAMuted},fontupper=\ttfamily\small,title={SALIDA ESPERADA\ifstrempty{#1}{}{ · #1}}}
\newcommand{\inlinecode}[1]{{\ttfamily\small\color{MAInk}\setlength{\fboxsep}{1.5pt}\colorbox{MASurfaceAlt}{#1}}}

