\newcommand{\MASectionBreak}[1]{%
  \par\Needspace{8\baselineskip}\vspace{1.2em}%
  \MAKicker{#1}\par\vspace{.4em}%
  {\color{MARule}\rule{\linewidth}{.5pt}}\par\vspace{.7em}%
}

