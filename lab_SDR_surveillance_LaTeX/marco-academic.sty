\newcommand{\MASelectPalette}[1]{%
  \ifcsname MA@definepalette@#1\endcsname
    \csname MA@definepalette@#1\endcsname
    \gdef\MA@currentpalette{#1}%
    \ifMA@tintedpaper\pagecolor{MACanvas}\fi
  \else
    \PackageWarning{marco-academic}{Unknown palette '#1'. Falling back to vertex}%
    \MA@definepalette@vertex
    \gdef\MA@currentpalette{vertex}%
  \fi
}
\MASelectPalette{\MA@palette}

%% ---------------------------------------------------------------------------
%% Typography and page geometry
%% ---------------------------------------------------------------------------
\ifdefstring{\MA@body}{sans}{\renewcommand{\familydefault}{\sfdefault}}{}
\KOMAoptions{parskip=half-,headings=normal,numbers=noendperiod}
\geometry{a4paper,top=23mm,bottom=25mm,left=24mm,right=24mm,headheight=16pt,headsep=7mm,footskip=13mm}
\linespread{1.035}
\setlength{\emergencystretch}{2em}
\raggedbottom
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

\setkomafont{disposition}{\sffamily\bfseries\color{MAInk}}
\setkomafont{section}{\sffamily\bfseries\Large\color{MAInk}}
\setkomafont{subsection}{\sffamily\bfseries\large\color{MAInk}}
\setkomafont{subsubsection}{\sffamily\bfseries\normalsize\color{MAInk}}
\setkomafont{paragraph}{\sffamily\bfseries\color{MAInk}}
\renewcommand*{\sectionformat}{\textcolor{MAPrimary}{\thesection}\enskip}
\renewcommand*{\subsectionformat}{\textcolor{MAPrimary}{\thesubsection}\enskip}
\renewcommand*{\subsubsectionformat}{\textcolor{MAMuted}{\thesubsubsection}\enskip}

\@ifundefined{chapter}{}{%
  \setkomafont{chapter}{\sffamily\bfseries\fontsize{27}{30}\selectfont\color{MAInk}}
  \renewcommand*{\chapterformat}{%
    \mbox{\textcolor{MAPrimary}{\sffamily\bfseries\fontsize{13}{13}\selectfont
    \MakeUppercase{\chaptername}\enskip\thechapter}}\par\vspace{.5ex}%
  }
}

%% ---------------------------------------------------------------------------
%% Metadata and setup
%% ---------------------------------------------------------------------------
\def\MA@title{Documento técnico}
\def\MA@subtitle{}
\def\MA@author{}
\def\MA@institution{}
\def\MA@course{}
\def\MA@doctype{}
\def\MA@code{}
\def\MA@version{1.0}
\def\MA@date{\today}
\def\MA@headerleft{\MA@course}
\def\MA@headerright{\MA@code}
\def\MA@footerleft{\MA@author}
\def\MA@covernote{}

\ifdefstring{\MA@mode}{lab}{\def\MA@doctype{Guía de laboratorio}}{}
\ifdefstring{\MA@mode}{notes}{\def\MA@doctype{Notas de clase}}{}
\ifdefstring{\MA@mode}{article}{\def\MA@doctype{Artículo técnico}}{}
\ifdefstring{\MA@mode}{manual}{\def\MA@doctype{Manual técnico}}{}

\pgfkeys{/ma/.is family,/ma,
  title/.store in=\MA@title,
  subtitle/.store in=\MA@subtitle,
  author/.store in=\MA@author,
  institution/.store in=\MA@institution,
  course/.store in=\MA@course,
  document-type/.store in=\MA@doctype,
  code/.store in=\MA@code,
  version/.store in=\MA@version,
  date/.store in=\MA@date,
  header-left/.store in=\MA@headerleft,
  header-right/.store in=\MA@headerright,
  footer-left/.store in=\MA@footerleft,
  cover-note/.store in=\MA@covernote
}
\newcommand{\MASetup}[1]{\pgfkeys{/ma,#1}}

%% ---------------------------------------------------------------------------
%% Headers / footers
%% ---------------------------------------------------------------------------
\setkomafont{pageheadfoot}{\normalfont\sffamily}
\clearpairofpagestyles
\ihead{\sffamily\footnotesize\color{MAMuted}\MA@headerleft}
\ohead{\sffamily\footnotesize\color{MAMuted}\MA@headerright}
\ifoot{\sffamily\scriptsize\color{MAMuted}\MA@footerleft}
\ofoot{\sffamily\scriptsize\color{MAMuted}\thepage\,/\,\pageref*{LastPage}}
\KOMAoptions{headsepline=.35pt}
\setkomafont{headsepline}{\color{MARule}}
\pagestyle{scrheadings}

%% ---------------------------------------------------------------------------
%% Hyperlinks, captions and references
%% ---------------------------------------------------------------------------
\ifMA@colorlinks
  \hypersetup{colorlinks=true,linkcolor=MAPrimaryDark,urlcolor=MAPrimaryDark,citecolor=MATertiary,pdfborder={0 0 0}}
\else
  \hypersetup{hidelinks}
\fi
\AtBeginDocument{%
  \hypersetup{pdftitle={\MA@title},pdfauthor={\MA@author},pdfsubject={\MA@subtitle}}%
  \ifMA@tintedpaper\pagecolor{MACanvas}\fi
}
\urlstyle{same}
\captionsetup{font=small,labelfont={sf,bf,color=MAInk},textfont={color=MAMuted},labelsep=period,skip=6pt}
\crefname{figure}{figura}{figuras}
\crefname{table}{tabla}{tablas}
\crefname{section}{sección}{secciones}
\crefname{equation}{ecuación}{ecuaciones}

%% ---------------------------------------------------------------------------
%% Cover / title system
%% ---------------------------------------------------------------------------
\newcommand{\MA@accentbars}{%
  {\setlength{\fboxsep}{0pt}%
  \colorbox{MAPrimary}{\rule{0pt}{4pt}\hspace{.48\linewidth}}%
  \colorbox{MASecondary}{\rule{0pt}{4pt}\hspace{.19\linewidth}}%
  \colorbox{MATertiary}{\rule{0pt}{4pt}\hspace{.12\linewidth}}}%
}

\newcommand{\MAMakeTitle}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \pagecolor{MACanvas}
  \color{MAInk}
  \vspace*{4mm}
  \begin{minipage}[t]{.66\linewidth}
    {\sffamily\bfseries\footnotesize\color{MAPrimary}\MakeUppercase{\MA@doctype}}\\[2mm]
    {\sffamily\scriptsize\color{MAMuted}\MA@course}
  \end{minipage}%
  \begin{minipage}[t]{.34\linewidth}
    \RaggedLeft{\sffamily\scriptsize\color{MAMuted}\MA@code}
  \end{minipage}

  \vspace{22mm}
  {\sffamily\bfseries\fontsize{34}{38}\selectfont\hyphenpenalty=10000\exhyphenpenalty=10000\RaggedRight \MA@title\par}
  \ifstrempty{\MA@subtitle}{}{%
    \vspace{5mm}
    {\fontsize{14}{20}\selectfont\color{MAMuted}\hyphenpenalty=10000\exhyphenpenalty=10000\RaggedRight \MA@subtitle\par}%
  }

  \vspace{10mm}
  \MA@accentbars

  \vfill
  \ifstrempty{\MA@covernote}{}{%
    \begin{tcolorbox}[enhanced,frame hidden,colback=MASurfaceAlt,boxrule=0pt,arc=2mm,left=5mm,right=5mm,top=4mm,bottom=4mm]
      {\sffamily\small\color{MAInk}\MA@covernote}
    \end{tcolorbox}
    \vspace{7mm}
  }

  \begin{tabularx}{\linewidth}{@{}>{\sffamily\small}X>{\sffamily\small\RaggedLeft\arraybackslash}X@{}}
    \textbf{\MA@author} & \textbf{Versión \MA@version}\\[1.5mm]
    \color{MAMuted}\MA@institution & \color{MAMuted}\MA@date
  \end{tabularx}
  \vspace{4mm}
  {\sffamily\scriptsize\color{MAMuted}MARCO ACADEMIC · palette \MA@currentpalette}
  \end{titlepage}
  \ifMA@tintedpaper\pagecolor{MACanvas}\else\nopagecolor\fi
}

\newcommand{\MAIntro}[1]{%
  \begin{tcolorbox}[enhanced,frame hidden,colback=MASurfaceAlt,boxrule=0pt,arc=2mm,left=5mm,right=5mm,top=4mm,bottom=4mm,borderline west={2.5pt}{0pt}{MAPrimary}]
  {\sffamily\fontsize{11.5}{16}\selectfont\color{MAInk}#1}
  \end{tcolorbox}
}
